// 2. DOM Elements
const phonesGrid = document.getElementById('phonesGrid');
const searchInput = document.getElementById('searchInput');
const filterBtns = document.querySelectorAll('.filter-btn');
const modalOverlay = document.getElementById('modalOverlay');
const modalBody = document.getElementById('modalBody');
const modalClose = document.getElementById('modalClose');

let activeFilter = 'all';
let searchQuery = '';

// 3. Render Functions
function renderPhones() {
  phonesGrid.innerHTML = '';

  const filtered = phonesData.filter(phone => {
    const matchesFilter = activeFilter === 'all' || phone.brand === activeFilter;
    const matchesSearch = phone.model.toLowerCase().includes(searchQuery.toLowerCase()) ||
                          phone.chipset.toLowerCase().includes(searchQuery.toLowerCase());
    return matchesFilter && matchesSearch;
  });

  if (filtered.length === 0) {
    phonesGrid.innerHTML = `<p style="grid-column: 1/-1; text-align: center; color: var(--text-secondary); padding: 3rem 0;">Hech qanday ma'lumot topilmadi.</p>`;
    return;
  }

  filtered.forEach((phone, index) => {
    const card = document.createElement('div');
    card.className = 'phone-card animate-fade';
    card.style.animationDelay = `${index * 0.05}s`;

    card.innerHTML = `
      <div>
        <div class="card-header">
          <div>
            <span class="phone-brand">${phone.brand}</span>
            <h3 class="phone-title">${phone.model}</h3>
          </div>
          <span class="phone-price">${phone.price}</span>
        </div>

        <ul class="specs-list">
          <li class="spec-item">
            <span class="spec-label">Protsessor</span>
            <span class="spec-value">${phone.chipset.split('(')[0]}</span>
          </li>
          <li class="spec-item">
            <span class="spec-label">Displey</span>
            <span class="spec-value">${phone.display.split(',')[1] || '120Hz'}</span>
          </li>
          <li class="spec-item">
            <span class="spec-label">Kamera</span>
            <span class="spec-value">${phone.camera.split('+')[0]}</span>
          </li>
          <li class="spec-item">
            <span class="spec-label">Batareya</span>
            <span class="spec-value">${phone.battery.split(',')[0]}</span>
          </li>
        </ul>
      </div>

      <button class="btn-detail" onclick="openModal('${phone.id}')">To'liq Xarakteristika</button>
    `;

    phonesGrid.appendChild(card);
  });
}

// 4. Modal Functions
window.openModal = function(phoneId) {
  const phone = phonesData.find(p => p.id === phoneId);
  if (!phone) return;

  modalBody.innerHTML = `
    <span class="phone-brand">${phone.brand}</span>
    <h2 style="font-size: 1.8rem; margin-bottom: 0.5rem;">${phone.model}</h2>
    <p style="color: var(--success); font-family: 'JetBrains Mono'; font-weight: 600; margin-bottom: 1.5rem;">Boshlang'ich narxi: ${phone.price}</p>

    <div class="detail-section">
      <h3>📱 Displey & Korpus</h3>
      <p style="color: var(--text-secondary); font-size: 0.95rem;">${phone.display}</p>
    </div>

    <div class="detail-section">
      <h3>⚙️ Unumdorlik & Chipset</h3>
      <p><strong>Chipset:</strong> ${phone.chipset}</p>
      <p><strong>CPU:</strong> ${phone.cpu}</p>
      <p><strong>GPU:</strong> ${phone.gpu}</p>
      <p><strong>Xotira turlari:</strong> ${phone.ram} | ${phone.storage}</p>
    </div>

    <div class="detail-section">
      <h3>📸 Kamera Tizimi</h3>
      <p><strong>Asosiy:</strong> ${phone.camera}</p>
      <p><strong>Frontal:</strong> ${phone.selfie}</p>
    </div>

    <div class="detail-section">
      <h3>🔋 Batareya & Dastur</h3>
      <p><strong>Akkumulyator:</strong> ${phone.battery}</p>
      <p><strong>Operatsion Tizim:</strong> ${phone.os}</p>
    </div>
  `;

  modalOverlay.classList.add('active');
};

function closeModal() {
  modalOverlay.classList.remove('active');
}

// 5. Event Listeners
searchInput.addEventListener('input', (e) => {
  searchQuery = e.target.value;
  renderPhones();
});

filterBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    filterBtns.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    activeFilter = btn.dataset.filter;
    renderPhones();
  });
});

modalClose.addEventListener('click', closeModal);
modalOverlay.addEventListener('click', (e) => {
  if (e.target === modalOverlay) closeModal();
});

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') closeModal();
});

// Initial Render
renderPhones();

